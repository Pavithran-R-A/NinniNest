{
  "expo": {
    "name": "NinniNest",
    "slug": "ninninest",
    "version": "0.9.1",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "ninninest",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "app.ninninest.journal",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F7F5F0"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.ninninest.journal",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "NinniNest lets you attach photos of your child to milestones and profiles.",
        "NSPhotoLibraryAddUsageDescription": "NinniNest can save milestone photos to your photo library."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "mode": "broadcast"
        }
      ],
      [
        "./plugins/withNdkVersion",
        {
          "ndkVersion": "27.1.12297006"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
